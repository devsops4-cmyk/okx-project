# Frontend (Vite) — copy to `.env`. All vars MUST be prefixed VITE_ to be exposed.

# Deployed SableVault address (from the deploy script output).
VITE_SABLE_VAULT_ADDRESS=

# Base URL of the agent backend. Leave blank in dev to use the Vite proxy.
VITE_AGENT_API_URL=http://localhost:8787

# WalletConnect Cloud project ID (https://cloud.walletconnect.com). Required by
# RainbowKit for mobile wallet connections.
VITE_WALLETCONNECT_PROJECT_ID=

# Target chain. 196 = X Layer mainnet; set to your testnet chain ID for testing.
VITE_XLAYER_CHAIN_ID=196
VITE_XLAYER_RPC_URL=https://rpc.xlayer.tech

# ERC20 token addresses on the target chain (symbol -> address). Fill after
# confirming from the explorer. Must match the addresses the agent backend uses.
VITE_TOKEN_OKB_ADDRESS=
VITE_TOKEN_USDC_ADDRESS=
VITE_TOKEN_WETH_ADDRESS=
